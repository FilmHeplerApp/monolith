COMPOSE_PROJECT_NAME=filmhelper

APP_NAME=FilmHelper
APP_ENV=local
APP_URL=http://localhost:8080
APP_PORT=8080
APP_KEY=
APP_DEBUG=true

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_FORWARD_PORT=5432
DB_DATABASE=filmhelper
DB_USERNAME=filmhelper
DB_PASSWORD=secret

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_DRIVER=redis

FILESYSTEM_DISK=s3

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_FORWARD_PORT=6379
REDIS_PASSWORD=null

AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=miniosecret
AWS_DEFAULT_REGION=ru-central1
AWS_BUCKET=filmhelper-local
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@filmhelper.local
MAIL_FROM_NAME="${APP_NAME}"

PROFILER_ENABLED=false

# Comma-separated: shikimori,anilist,jikan,tmdb,mock
IMPORT_PROVIDERS=mock

# Shikimori
SHIKIMORI_ENDPOINT=https://shikimori.io/api/graphql
SHIKIMORI_USER_AGENT=FilmHelperApp
SHIKIMORI_TIMEOUT=15
SHIKIMORI_PAGE_SIZE=50
SHIKIMORI_THROTTLE_MS=700
SHIKIMORI_RETRIES=3
SHIKIMORI_RETRY_BACKOFF_MS=1000
SHIKIMORI_DUMP_PATH=

# Optional import filters. Empty values disable the threshold.
IMPORT_MIN_RELEASE_YEAR=
IMPORT_MIN_PROVIDER_SCORE=
IMPORT_MIN_PROVIDER_SCORE_COUNT=
IMPORT_CHECKPOINT_EVERY=50
